# @astrojs/tailwind@6.x declares peer astro@"^3||^4||^5" but works fine
# with Astro 6. The package has not yet published a peer-dep update for
# Astro 6 compatibility. Using legacy-peer-deps lets npm ci proceed
# without error until an official @astrojs/tailwind release adds ^6.
legacy-peer-deps=true
