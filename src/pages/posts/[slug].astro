---
import ArticleLayout from '@/layouts/ArticleLayout.astro'
import AssessmentCTA from '@/components/AssessmentCTA.astro'
import Comments from '@/components/Comments.astro'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { readingTime } from '@/lib/readingTime'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<'posts'>
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const rt = readingTime(entry.body ?? '')

// "Keep reading": other posts first, then published sectors in sector order.
const otherPosts = (await getCollection('posts', ({ data, id }) => !data.draft && id !== entry.id)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
)
const sectors = (await getCollection('sectors', ({ data }) => !data.draft)).sort(
  (a, b) => Number(a.data.sectorId.slice(1)) - Number(b.data.sectorId.slice(1)),
)
const related = [
  ...otherPosts.map((p) => ({ href: `/posts/${p.id}/`, kicker: 'Post', title: p.data.title, blurb: p.data.description })),
  ...sectors.map((s) => ({ href: `/sectors/${s.data.sectorSlug}/`, kicker: `Sector ${s.data.sectorId}`, title: s.data.title, blurb: s.data.heroTagline })),
].slice(0, 3)
---

<ArticleLayout
  kind="post"
  title={entry.data.title}
  description={entry.data.description}
  kicker="Post"
  author={entry.data.author}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  readingTime={rt}
  tags={entry.data.tags}
  takeaways={entry.data.takeaways}
  headings={headings}
  related={related}
  path={`/posts/${entry.id}/`}
>
  <Content />
  <Fragment slot="after"><AssessmentCTA /></Fragment>
  <Fragment slot="comments"><Comments /></Fragment>
</ArticleLayout>
