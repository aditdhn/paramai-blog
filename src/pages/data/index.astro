---
import BaseLayout from '@/layouts/BaseLayout.astro'
import AssessmentCTA from '@/components/AssessmentCTA.astro'
import {
  FIELDS,
  LADDERS,
  ALL_INDIA_MEDIAN_RS,
  DATA_PERIOD,
  HEADLINE_STATS,
  formatRs,
  formatNum,
} from '@/lib/careerStats'

// The free page shows the top 5 fields by median; everything else is not
// rendered at all (it lives on paramai.in, behind the free assessment).
const SHOWN = 5
const PAY_MAX = 60000 // axis ceiling for the bars (above the highest mean)
const byPay = [...FIELDS].sort((a, b) => b.medianRs - a.medianRs)
const byShare = [...FIELDS].sort((a, b) => b.regularSharePct - a.regularSharePct)
const shown = byPay.slice(0, SHOWN)
const hiddenCount = FIELDS.length - SHOWN
const top = byPay[0]
const bottom = byPay[byPay.length - 1]
const aboveMedian = FIELDS.filter((x) => x.medianRs >= ALL_INDIA_MEDIAN_RS).length
const lowestShare = byShare[byShare.length - 1]
const multiple = (top.medianRs / bottom.medianRs).toFixed(1)
const short = (n: string) => n.split(' &')[0]
const shownSample = shown.reduce((s, x) => s + x.sampleN, 0)
const smallShown = [...shown].sort((a, b) => a.sampleN - b.sampleN)[0]
const pct = (v: number, max: number) => `${((v / max) * 100).toFixed(2)}%`

const insights = [
  {
    big: `${multiple}×`,
    text: `${short(top.name)} has a ${formatRs(top.medianRs)} median, ${multiple} times ${bottom.name}’s ${formatRs(bottom.medianRs)}.`,
  },
  {
    big: `${aboveMedian} of ${FIELDS.length}`,
    text: `fields have a salaried median above the all-India median of ${formatRs(ALL_INDIA_MEDIAN_RS)} a month.`,
  },
  {
    big: `${lowestShare.regularSharePct}%`,
    text: `of ${short(lowestShare.name)} workers are on a regular salary. The rest are not on a regular salary.`,
  },
]
---

<BaseLayout
  title="The numbers behind the careers | ParamAI™ Blog"
  description={`What the top career fields pay in India (${DATA_PERIOD}), with the limits of each figure stated. See all ${FIELDS.length} fields and the pay ladders on paramai.in.`}
>
  <section class="mx-auto max-w-5xl px-4 pt-14 pb-6 sm:px-6 sm:pt-20">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400">Data</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-5xl">The numbers behind the careers</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-600 dark:text-ink-300">
      We keep our career data tied to named sources. These figures come from India’s national labour
      survey and from published government pay rules, with the limits stated beside each chart. Pay is
      indicative context for exploring careers, not a promise of what any job will pay.
    </p>

    <ul class="ds-stats mt-10" aria-label="Key figures">
      {
        HEADLINE_STATS.map((s, i) => (
          <li class={`ds-stat ds-a${i}`}>
            <div class="ds-stat-v">{s.value}</div>
            <div class="ds-stat-l">{s.label}</div>
            <p class="ds-stat-d">{s.detail}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ───────── Top fields (free preview) ───────── */}
  <section class="mx-auto max-w-5xl px-4 py-6 sm:px-6" aria-labelledby="field-heading">
    <div class="ds-card">
      <p class="ds-eyebrow">Pay by career field</p>
      <h2 id="field-heading" class="text-xl font-bold leading-tight tracking-tight sm:text-2xl">
        The {SHOWN} highest-paying career fields, by median monthly pay
      </h2>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-ink-600 dark:text-ink-300">
        Monthly earnings of regular wage and salaried workers. Showing the {SHOWN} highest medians of the
        {FIELDS.length} fields a Class 10 student explores on ParamAI™, not a typical career. Source: NSO
        Periodic Labour Force Survey, {DATA_PERIOD.replace('NSO PLFS, ', '')}.
      </p>

      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        {
          insights.map((i) => (
            <div class="ds-insight">
              <div class="ds-insight-big">{i.big}</div>
              <p>{i.text}</p>
            </div>
          ))
        }
      </div>

      <ol class="ds-rows mt-7">
        {
          shown.map((f, idx) => (
            <li class="ds-row">
              <div class="ds-name">
                <span>{f.name}</span>
                {f.note && <span class="ds-note">{f.note}</span>}
              </div>
              <div class="ds-track" aria-hidden="true">
                <span class="ds-ref" style={`left:${pct(ALL_INDIA_MEDIAN_RS, PAY_MAX)}`} />
                <span class="ds-bar" style={`width:${pct(f.medianRs, PAY_MAX)};--i:${idx}`} />
                <span class="ds-mean" style={`left:${pct(f.meanRs, PAY_MAX)}`} />
              </div>
              <div class="ds-val">{formatRs(f.medianRs)}</div>
            </li>
          ))
        }
      </ol>
      <div class="ds-legend">
        <span><i class="ds-key-mean"></i> Mean (average) pay</span>
        <span><i class="ds-key-ref"></i> All-India median {formatRs(ALL_INDIA_MEDIAN_RS)}</span>
      </div>

      <details class="mt-5">
        <summary class="ds-summary">How to read this, and what it does not show</summary>
        <ul class="ds-notes">
          <li>
            Pay is the median for <strong>regular wage and salaried workers only</strong>, in rupees per
            month, from {formatNum(shownSample)} sampled salaried workers in these {SHOWN} fields. Workers
            who are not on a regular salary are not in the pay figures.
          </li>
          <li>
            Fields are built from three-digit occupation groups (NCO-2015), which are wider than a single
            career. Read them as context, not as a promise of what any one role pays. Pay is indicative.
          </li>
          <li>
            Nine months of one year is a snapshot, not a trend. {smallShown.name} rests on only {formatNum(smallShown.sampleN)} salaried
            records.
          </li>
          <li>
            The dashed line is the all-India median ({formatRs(ALL_INDIA_MEDIAN_RS)}) across every salaried worker, not
            a target for any one career.
          </li>
        </ul>
      </details>

      <details class="mt-3">
        <summary class="ds-summary">Table version of this chart</summary>
        <div class="ds-table-wrap">
          <table class="ds-table">
            <caption class="sr-only">Median and mean monthly pay, and share on a regular salary, for the {SHOWN} highest-paying fields</caption>
            <thead>
              <tr>
                <th scope="col">Field</th>
                <th scope="col" class="r">Median pay / month</th>
                <th scope="col" class="r">Mean pay / month</th>
                <th scope="col" class="r">On a regular salary</th>
              </tr>
            </thead>
            <tbody>
              {
                shown.map((f) => (
                  <tr>
                    <th scope="row">{f.name}</th>
                    <td class="r">{formatRs(f.medianRs)}</td>
                    <td class="r">{formatRs(f.meanRs)}</td>
                    <td class="r">{f.regularSharePct}%</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </details>
    </div>
  </section>

  {/* ───────── What is on paramai.in ───────── */}
  <section class="mx-auto max-w-3xl px-4 pt-2 sm:px-6" aria-labelledby="more-heading">
    <h2 id="more-heading" class="text-xl font-bold tracking-tight sm:text-2xl">There is more on paramai.in</h2>
    <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-6 text-ink-600 dark:text-ink-300">
      <li>The other {hiddenCount} fields, with their median and mean pay.</li>
      <li>The share of each field’s workers who are on a regular salary.</li>
      <li>Pay ladders for {LADDERS.map((l) => l.name).join(', ')}, stage by stage, as basic pay before allowances.</li>
      <li>Which careers match your own profile.</li>
    </ul>
    <p class="mt-3 text-sm text-ink-600 dark:text-ink-300">The assessment is free.</p>
    <AssessmentCTA
      medium="data"
      campaign="data"
      label={`See all ${FIELDS.length} fields and the pay ladders, and see which careers match YOUR profile`}
    />
  </section>

  <style is:global>
    :root {
      --ds-card: #ffffff;
      --ds-card-b: rgba(124, 58, 237, 0.22);
      --ds-soft: rgba(15, 23, 42, 0.05);
      --ds-line: rgba(15, 23, 42, 0.14);
      --ds-ax: #475569;
      --ds-a0: #0891b2;
      --ds-a1: #7c3aed;
      --ds-a2: #ea580c;
      --ds-a3: #059669;
      --ds-bar1: #7c3aed;
      --ds-bar2: #0891b2;
    }
    :root.dark {
      --ds-card: #0b1022;
      --ds-card-b: rgba(124, 58, 237, 0.3);
      --ds-soft: rgba(255, 255, 255, 0.05);
      --ds-line: rgba(255, 255, 255, 0.14);
      --ds-ax: #94a3b8;
      --ds-a0: #22d3ee;
      --ds-a1: #a78bfa;
      --ds-a2: #fb923c;
      --ds-a3: #34d399;
    }

    .ds-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; list-style: none; padding: 0; margin-bottom: 0; }
    @media (min-width: 1024px) { .ds-stats { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; } }
    .ds-stat { border-radius: 1rem; padding: 1rem; background: var(--ds-card); border: 1px solid var(--ds-line); border-top: 3px solid var(--c); }
    .ds-a0 { --c: var(--ds-a0); } .ds-a1 { --c: var(--ds-a1); } .ds-a2 { --c: var(--ds-a2); } .ds-a3 { --c: var(--ds-a3); }
    .ds-stat-v { font-size: 1.5rem; line-height: 1; font-weight: 700; font-variant-numeric: tabular-nums; }
    @media (min-width: 640px) { .ds-stat-v { font-size: 2.25rem; } .ds-stat { padding: 1.25rem; } }
    .ds-stat-l { margin-top: 0.5rem; font-size: 0.8125rem; font-weight: 600; color: var(--c); }
    .ds-stat-d { margin-top: 0.375rem; font-size: 0.75rem; line-height: 1.25rem; color: var(--ds-ax); }

    .ds-card { border-radius: 1.5rem; padding: 1.25rem; background: var(--ds-card); border: 1px solid var(--ds-card-b); }
    @media (min-width: 640px) { .ds-card { padding: 2rem; } }
    .ds-eyebrow { font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 0.75rem; color: var(--ds-a0); }
    .ds-eyebrow-green { color: var(--ds-a3); }
    .ds-insight { border-radius: 1rem; padding: 1rem; background: var(--ds-soft); border: 1px solid var(--ds-line); }
    .ds-insight-big { font-size: 1.5rem; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--ds-a1); }
    .ds-insight p { margin-top: 0.25rem; font-size: 0.78rem; line-height: 1.25rem; color: var(--ds-ax); }


    .ds-rows { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
    .ds-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 0.75rem; row-gap: 0.25rem; align-items: center; }
    .ds-name { grid-column: 1 / -1; font-size: 0.8125rem; font-weight: 600; line-height: 1.2; display: flex; flex-direction: column; min-width: 0; }
    .ds-note { font-size: 0.6875rem; font-weight: 400; line-height: 1rem; margin-top: 0.125rem; color: var(--ds-ax); }
    .ds-track { position: relative; height: 22px; border-radius: 9999px; background: var(--ds-soft); }
    .ds-bar { position: absolute; inset: 0 auto 0 0; border-radius: 9999px; background: linear-gradient(90deg, var(--ds-bar1), var(--ds-bar2)); }
    .ds-ref { position: absolute; top: -3px; bottom: -3px; border-left: 1px dashed var(--ds-ax); z-index: 1; }
    .ds-mean { position: absolute; top: 50%; width: 10px; height: 10px; transform: translate(-50%, -50%) rotate(45deg); background: #fff; border: 1.5px solid #0f172a; z-index: 2; }
    .ds-val { min-width: 4.6rem; text-align: right; font-size: 0.8125rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    @media (min-width: 640px) {
      .ds-row { grid-template-columns: 14rem minmax(0, 1fr) 5.2rem; }
      .ds-name { grid-column: auto; }
    }
    .ds-legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-top: 1.25rem; font-size: 0.72rem; color: var(--ds-ax); }
    .ds-legend span { display: inline-flex; align-items: center; gap: 0.375rem; }
    .ds-legend i { display: inline-block; flex: none; }
    .ds-key-mean { width: 8px; height: 8px; transform: rotate(45deg); background: #fff; border: 1.5px solid #0f172a; }
    .ds-key-ref { height: 12px; border-left: 1px dashed var(--ds-ax); }

    .ds-summary:focus-visible { outline: 2px solid #2563eb; outline-offset: 2px; }
    .ds-summary { cursor: pointer; font-size: 0.78rem; font-weight: 600; color: var(--ds-a0); }
    .ds-notes { margin-top: 0.75rem; padding-left: 1rem; list-style: disc; display: grid; gap: 0.375rem; font-size: 0.78rem; line-height: 1.25rem; color: var(--ds-ax); }
    .ds-notes strong { color: inherit; }

    .ds-table-wrap { margin-top: 0.75rem; overflow-x: auto; border-radius: 1rem; border: 1px solid var(--ds-line); }
    .ds-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.78rem; }
    .ds-table caption.sr-only { position: absolute; }
    .ds-table th, .ds-table td { padding: 0.6rem 0.75rem; border-top: 1px solid var(--ds-line); font-variant-numeric: tabular-nums; }
    .ds-table thead th { border-top: 0; background: var(--ds-soft); font-weight: 600; color: var(--ds-ax); white-space: nowrap; }
    .ds-table tbody th { font-weight: 600; }
    .ds-table .r { text-align: right; }
    .ds-table td.r { white-space: nowrap; }


    @media (prefers-reduced-motion: no-preference) {
      .ds-bar { animation: ds-grow 900ms cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(var(--i) * 45ms); transform-origin: left; }
    }
    @keyframes ds-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  </style>
</BaseLayout>
