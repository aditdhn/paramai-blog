---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { readingTime } from '@/lib/readingTime'

const sectors = (await getCollection('sectors')).sort(
  (a, b) => Number(a.data.sectorId.slice(1)) - Number(b.data.sectorId.slice(1)),
)

// A sector is a stub if it is a draft or still has TODO placeholders. Stubs are
// listed as non-clickable 'Coming soon' cards (their pages are noindex, not in the sitemap).
const isStubEntry = (s: (typeof sectors)[number]) => s.data.draft || s.body.trim().includes('> **TODO:**')
const published = sectors.filter((s) => !isStubEntry(s)).length
---

<BaseLayout
  title="All 41 career sectors | ParamAI™ Blog"
  description="Browse all 41 career sectors covered by ParamAI™'s knowledge bank — from AI/ML to skilled trades."
>
  <section class="mx-auto max-w-5xl px-6 py-16">
    <p class="text-xs font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400">
      Sectors
    </p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-5xl">All 41 sectors</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-600 dark:text-ink-300">
      Every sector covered by ParamAI™'s career knowledge bank. We're writing a
      full guide for each one — <strong>{published}</strong> of 41 are fully
      written so far, the rest have stubs you can watch for updates.
    </p>

    <ul class="mt-10 grid gap-4">
      {
        sectors.map((sector) => {
          const isStub = isStubEntry(sector)
          const Tag = isStub ? 'div' : 'a'
          return (
            <li>
              <Tag
                href={isStub ? undefined : `/sectors/${sector.data.sectorSlug}/`}
                class={`group flex items-center justify-between gap-4 rounded-3xl border border-ink-200 bg-white p-5 shadow-soft sm:p-6 dark:border-ink-700 dark:bg-ink-900 ${isStub ? 'opacity-80' : 'transition-all hover:-translate-y-1 hover:border-brand-300 hover:shadow-cozy'}`}
              >
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <span class="text-[11px] font-mono font-semibold text-ink-500 dark:text-ink-400">
                      {sector.data.sectorId}
                    </span>
                    {!isStub && (
                      <span class="rounded-full bg-accent-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-accent-700 dark:bg-accent-900/60 dark:text-accent-200">
                        Written
                      </span>
                    )}
                    {isStub && (
                      <span class="rounded-full bg-ink-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-ink-500 dark:bg-ink-800/60 dark:text-ink-400">
                        Coming soon
                      </span>
                    )}
                  </div>
                  <h2 class="mt-1 text-lg font-bold group-hover:text-brand-600 dark:group-hover:text-brand-400">
                    {sector.data.title}
                  </h2>
                  <p class="mt-0.5 text-sm text-ink-600 dark:text-ink-300">
                    {sector.data.heroTagline}
                  </p>
                  {!isStub && (
                    <p class="mt-2 flex flex-wrap items-center gap-2 text-xs text-ink-600 dark:text-ink-300">
                      <span>{readingTime(sector.body ?? '')}</span>
                      {sector.data.tags.filter((t) => t !== 'sector').slice(0, 3).map((t) => (<span class="rounded-full bg-brand-100 px-2 py-0.5 font-medium text-brand-800 dark:bg-brand-900/60 dark:text-brand-200">{t}</span>))}
                      {sector.data.updatedDate && <span class="font-medium text-accent-700 dark:text-accent-300">Updated {sector.data.updatedDate.toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}</span>}
                    </p>
                  )}
                </div>
                <span class="hidden text-brand-600 group-hover:translate-x-0.5 transition-transform sm:block dark:text-brand-400">
                  →
                </span>
              </Tag>
            </li>
          )
        })
      }
    </ul>
  </section>
</BaseLayout>
