---
import ArticleLayout from '@/layouts/ArticleLayout.astro'
import AssessmentCTA from '@/components/AssessmentCTA.astro'
import Comments from '@/components/Comments.astro'
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { readingTime } from '@/lib/readingTime'
import { FIELDS, formatRs } from '@/lib/careerStats'

export async function getStaticPaths() {
  const sectors = await getCollection('sectors')
  return sectors.map((entry) => ({
    params: { slug: entry.data.sectorSlug },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<'sectors'>
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const rt = readingTime(entry.body ?? '')

// Related sectors: up to 3 others, same collection, different slug.
// Prefer ones whose tags overlap; fall back to the next in sector order.
const allSectors = await getCollection('sectors', ({ data }) => !data.draft && data.sectorSlug !== entry.data.sectorSlug)
const thisTags = new Set(entry.data.tags)
const withOverlap = allSectors
  .map((s) => ({ s, overlap: s.data.tags.filter((t) => thisTags.has(t)).length }))
  .sort((a, b) => b.overlap - a.overlap || Number(a.s.data.sectorId.slice(1)) - Number(b.s.data.sectorId.slice(1)))
  .slice(0, 3)
  .map((x) => x.s)
const related = withOverlap.map((s) => ({
  href: `/sectors/${s.data.sectorSlug}/`,
  kicker: `Sector ${s.data.sectorId}`,
  title: s.data.title,
  blurb: s.data.heroTagline,
}))

// "At a glance": facts about the page, plus the closest PLFS field when mapped.
const field = entry.data.dataField ? FIELDS.find((f) => f.id === entry.data.dataField) : undefined
const glance: [string, string][] = [
  ['Sector', entry.data.sectorId],
  ['Reading time', rt.replace(' read', '')],
  ['Topics', entry.data.tags.filter((t) => t !== 'sector').slice(0, 3).join(', ') || 'Career guide'],
]
if (field) glance.push([`Pay data (${field.name})`, `${formatRs(field.medianRs)} median / month`])
---

<ArticleLayout
  kind="sector"
  title={entry.data.title}
  description={entry.data.description}
  tagline={entry.data.heroTagline}
  kicker={`Sector guide · ${entry.data.sectorId}`}
  author={entry.data.author}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  readingTime={rt}
  tags={entry.data.tags}
  takeaways={entry.data.takeaways}
  headings={headings}
  related={related}
  relatedTitle="Related sectors"
  canonical={entry.data.canonicalToApp}
  path={`/sectors/${entry.data.sectorSlug}/`}
>
  <aside class="not-prose mb-8 rounded-3xl border border-accent-200 bg-accent-50 p-5 shadow-soft dark:border-accent-700/50 dark:bg-accent-950/60" aria-labelledby="glance-h">
    <h2 id="glance-h" class="text-sm font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-300">At a glance</h2>
    <dl class="mt-3 grid gap-x-6 gap-y-3 sm:grid-cols-2">
      {glance.map(([k, v]) => (
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wider text-ink-600 dark:text-ink-300">{k}</dt>
          <dd class="mt-0.5 text-base font-medium text-ink-900 dark:text-ink-50">{v}</dd>
        </div>
      ))}
    </dl>
    {field && (
      <p class="mt-3 text-xs leading-5 text-ink-600 dark:text-ink-300">
        Pay is NSO PLFS data for regular wage and salaried workers in the closest field, not a promise for any one role.
      </p>
    )}
  </aside>
  <Content />
  <Fragment slot="after"><AssessmentCTA sectorSlug={entry.data.sectorSlug} /></Fragment>
  <Fragment slot="comments"><Comments /></Fragment>
</ArticleLayout>
