---
// "What the data says" block. Every number comes from src/data/career-stats.json
// (NSO PLFS pay data) via src/lib/careerStats.ts; nothing is typed here.
import { FIELDS, ALL_INDIA_MEDIAN_RS, DATA_PERIOD, formatRs, formatNum } from '@/lib/careerStats'

interface Props {
  /** field id in career-stats.json, e.g. "technology" */
  fieldId: string
  /** the page's own topic, used in the sentence "closest field to ..." */
  topic: string
}
const { fieldId, topic } = Astro.props
const f = FIELDS.find((x) => x.id === fieldId)
if (!f) throw new Error(`DataSnapshot: unknown field id "${fieldId}"`)
const notSalaried = Math.round((100 - f.regularSharePct) * 10) / 10
---

<aside class="data-snapshot not-prose my-8 rounded-3xl border border-accent-200 bg-accent-50 p-6 shadow-soft dark:border-accent-700/50 dark:bg-accent-950/60" aria-labelledby={`ds-${fieldId}`}>
  <p id={`ds-${fieldId}`} class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-300">
    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path></svg>
    What the data says
  </p>
  <p class="mt-2 text-base leading-7 text-ink-700 dark:text-ink-200">
    The closest field to {topic} in our pay data is <strong>{f.name}</strong>. Regular wage and salaried
    workers in that field earn a median of <strong>{formatRs(f.medianRs)}</strong> a month (mean {formatRs(f.meanRs)}),
    against an all-India median of {formatRs(ALL_INDIA_MEDIAN_RS)}.
  </p>
  <ul class="mt-3 list-disc space-y-1 pl-5 text-sm leading-6 text-ink-600 dark:text-ink-300">
    <li>{f.regularSharePct}% of workers in this field are on a regular salary. The other {notSalaried}% are not on a regular salary and are not in the pay figures.</li>
    <li>Based on {formatNum(f.sampleN)} sampled salaried workers. Source: NSO Periodic Labour Force Survey, {DATA_PERIOD.replace('NSO PLFS, ', '')}.</li>
    <li>A field is wider than any single role, so this is indicative context, not a promise of what a job will pay.</li>
  </ul>
  <p class="mt-3 text-sm"><a href="/data/" class="font-semibold text-brand-600 underline underline-offset-2 hover:text-brand-700 dark:text-brand-300 dark:hover:text-brand-200">See the numbers behind the careers →</a></p>
</aside>
