---
// Decorative hero illustration: sun, soft hills, a winding path and an open
// book. Inline SVG only (no raster images). Hidden from assistive tech.
---

<svg
  viewBox="0 0 640 300"
  class="mx-auto h-auto w-full max-w-2xl overflow-hidden rounded-3xl"
  aria-hidden="true"
  focusable="false"
  role="presentation"
>
  {/* sky blob */}
  <ellipse cx="320" cy="170" rx="300" ry="130" class="fill-brand-100/70 dark:fill-brand-900/25"></ellipse>

  {/* sun with soft halo */}
  <g class="hero-sun">
    <circle cx="500" cy="92" r="64" class="fill-amber-200/50 dark:fill-amber-300/10"></circle>
    <circle cx="500" cy="92" r="42" class="fill-amber-300 dark:fill-amber-400/80"></circle>
  </g>

  {/* clouds */}
  <g class="fill-white dark:fill-ink-800" opacity="0.95">
    <path d="M96 84a22 22 0 0 1 42-8 18 18 0 0 1 32 10 16 16 0 0 1-4 31H112a20 20 0 0 1-16-33z"></path>
    <path d="M318 52a16 16 0 0 1 30-5 13 13 0 0 1 24 8 12 12 0 0 1-3 23h-44a13 13 0 0 1-7-26z"></path>
  </g>

  {/* hills */}
  <path d="M0 214c70-46 150-66 230-52 80 14 120 56 210 40 80-14 140-38 200-18v116H0z" class="fill-accent-200 dark:fill-accent-900"></path>
  <path d="M0 244c90-34 170-34 260-10 90 24 160 18 380-26v92H0z" class="fill-accent-300 dark:fill-accent-800"></path>
  <path d="M0 276c110-22 210-20 320-6 110 14 220 8 320-14v44H0z" class="fill-accent-400 dark:fill-accent-700"></path>

  {/* winding path */}
  <path
    d="M338 300c-34-22 54-38 12-58s-70-14-52-34 60-18 70-36"
    fill="none"
    stroke-width="14"
    stroke-linecap="round"
    class="stroke-brand-200 dark:stroke-brand-300/60"
  ></path>

  {/* lamp post */}
  <g class="stroke-ink-700 dark:stroke-ink-200" stroke-width="3" stroke-linecap="round" fill="none">
    <path d="M150 262V206"></path>
    <path d="M150 206q0-10 10-10"></path>
  </g>
  <g class="hero-glow">
    <circle cx="164" cy="198" r="14" class="fill-amber-200/60 dark:fill-amber-300/20"></circle>
    <circle cx="164" cy="198" r="7" class="fill-amber-400"></circle>
  </g>

  {/* open book on the front hill */}
  <g transform="translate(250 232)">
    <path d="M0 14c16-10 34-10 50-2v26c-16-8-34-8-50 2z" class="fill-white stroke-ink-300 dark:fill-ink-200 dark:stroke-ink-500" stroke-width="2"></path>
    <path d="M100 14c-16-10-34-10-50-2v26c16-8 34-8 50 2z" class="fill-brand-50 stroke-ink-300 dark:fill-ink-100 dark:stroke-ink-500" stroke-width="2"></path>
    <path d="M10 22c10-4 22-4 32 0M10 30c10-4 22-4 32 0M58 22c10-4 22-4 32 0M58 30c10-4 22-4 32 0" fill="none" stroke-width="2" stroke-linecap="round" class="stroke-brand-400"></path>
  </g>

  {/* little decorative shapes */}
  <g class="fill-brand-300 dark:fill-brand-400/70">
    <circle cx="60" cy="150" r="5"></circle>
    <circle cx="590" cy="170" r="4"></circle>
    <circle cx="405" cy="130" r="3.5"></circle>
  </g>
  <g class="fill-accent-400 dark:fill-accent-300/70">
    <rect x="108" y="140" width="9" height="9" rx="2" transform="rotate(20 112 144)"></rect>
    <rect x="560" y="120" width="8" height="8" rx="2" transform="rotate(-18 564 124)"></rect>
  </g>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-sun { animation: hero-bob 7s ease-in-out infinite; transform-origin: 500px 92px; }
    .hero-glow { animation: hero-flicker 4s ease-in-out infinite; }
  }
  @keyframes hero-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  @keyframes hero-flicker { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }
</style>
