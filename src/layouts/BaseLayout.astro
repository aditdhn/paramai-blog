---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL, APP_URL } from '@/consts'

interface Props {
  title?: string
  description?: string
  canonical?: string
  ogImage?: string
  /** structured data objects, emitted as application/ld+json */
  jsonLd?: object | object[]
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  canonical,
  ogImage = '/og-default.png',
  jsonLd,
} = Astro.props

const canonicalURL = canonical ?? new URL(Astro.url.pathname, SITE_URL).toString()
const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Google tag (gtag.js) — same GA4 property/measurement ID as paramai.in,
        so cross-domain linking (configured in GA4 admin) can stitch a
        paramai.in <-> paramai.blog visit into one session instead of two. */}
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-L65W7903RB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', 'G-L65W7903RB')
    </script>

    <meta name="theme-color" content="#FFF8F0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, SITE_URL).toString()} />
    <meta property="og:site_name" content="ParamAI™ Blog" />
    <meta name="robots" content="index, follow" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE_URL).toString()} />


    <style is:global>
      /* Comfortable reading size and rhythm */
      .cozy-body { font-size: 1.0625rem; line-height: 1.7; }
      /* Soft paper-dot texture */
      .cozy-body {
        background-image: radial-gradient(rgba(122, 99, 84, 0.10) 1px, transparent 1px);
        background-size: 22px 22px;
      }
      .dark .cozy-body {
        background-image: radial-gradient(rgba(217, 197, 173, 0.07) 1px, transparent 1px);
      }
      /* Visible focus for keyboard users */
      :focus-visible { outline: 3px solid #C2410C; outline-offset: 3px; border-radius: 6px; }
      .dark :focus-visible { outline-color: #FDB074; }
      /* Respect reduced motion: stop all animation and transitions */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
      }

      /* Theme the /data/ page (and any page using --ds-* tokens) from here */
      html:root {
        --ds-card: #FFFFFF; --ds-card-b: rgba(194, 65, 12, 0.22); --ds-soft: rgba(122, 99, 84, 0.08);
        --ds-line: rgba(122, 99, 84, 0.22); --ds-grid: rgba(122, 99, 84, 0.2); --ds-ax: #5F4A3E; --ds-halo: #FFFFFF;
        --ds-a0: #2F6F60; --ds-a1: #C2410C; --ds-a2: #9A6B00; --ds-a3: #3E8776;
        --ds-bar1: #2F6F60; --ds-bar2: #5BA391;
        --ds-warm1: #C2410C; --ds-warm2: #F97316; --ds-warm-t: #9A3412;
        --ds-l0: #2F6F60; --ds-l1: #C2410C; --ds-l2: #7A5FA8; --ds-l3: #9A6B00;
      }
      html:root.dark {
        --ds-card: #2E2029; --ds-card-b: rgba(253, 176, 116, 0.28); --ds-soft: rgba(255, 255, 255, 0.06);
        --ds-line: rgba(217, 197, 173, 0.22); --ds-grid: rgba(217, 197, 173, 0.18); --ds-ax: #D9C5AD; --ds-halo: #2E2029;
        --ds-a0: #85BFAE; --ds-a1: #FDB074; --ds-a2: #F5C453; --ds-a3: #B3D8CC;
        --ds-bar1: #5BA391; --ds-bar2: #B3D8CC;
        --ds-warm-t: #FDB074;
        --ds-l0: #85BFAE; --ds-l1: #FDB074; --ds-l2: #C9B3F0; --ds-l3: #F5C453;
      }
      html:root .ds-card { border-radius: 1.75rem; box-shadow: 0 2px 4px rgba(74,56,47,0.05), 0 18px 40px -18px rgba(74,56,47,0.22); }
      html:root .ds-toggle button[aria-pressed='true'] { background: #C2410C; color: #fff; }
      html:root .ds-toggle button:focus-visible, html:root .ds-tab:focus-visible, html:root .ds-summary:focus-visible { outline: 3px solid #C2410C; }
      html:root.dark .ds-toggle button[aria-pressed='true'] { background: #FDB074; color: #2E2029; }
      html:root .ds-mean, html:root .ds-key-mean { border-color: #2E2029; }
    </style>

    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    {/* Dark mode: apply saved preference before first paint to avoid flash. */}
    <script is:inline>
      ;(() => {
        // Light-first: dark only when the visitor chose it.
        const saved = localStorage.getItem('theme')
        if (saved === 'dark') {
          document.documentElement.classList.add('dark')
        }
      })()
    </script>
  </head>
  <body
    class="cozy-body min-h-screen bg-cream font-sans text-ink-900 antialiased transition-colors duration-300 dark:bg-ink-950 dark:text-ink-100"
  >
    <header class="sticky top-0 z-40 border-b border-ink-200/70 bg-cream/85 backdrop-blur-lg dark:border-ink-800/70 dark:bg-ink-950/85">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a href="/" class="group flex items-center gap-2 text-lg font-bold">
          <span
            class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-brand-600 to-accent-500 text-white shadow-lg shadow-brand-500/30 transition-transform group-hover:scale-105"
          >
            P
          </span>
          <span class="text-ink-900 dark:text-ink-50">ParamAI<sup>™</sup> Blog</span>
        </a>

        <nav class="flex items-center gap-1 text-sm font-medium sm:gap-2">
          <a
            href="/sectors/"
            class:list={[
              'rounded-lg px-3 py-2 transition-colors hover:bg-ink-100 dark:hover:bg-ink-800',
              currentPath.startsWith('/sectors') && 'text-brand-600 dark:text-brand-400',
            ]}
          >
            Sectors
          </a>
          <a
            href="/data/"
            class:list={[
              'rounded-lg px-3 py-2 transition-colors hover:bg-ink-100 dark:hover:bg-ink-800',
              currentPath.startsWith('/data') && 'text-brand-600 dark:text-brand-400',
            ]}
          >
            Data
          </a>
          <a
            href="/posts/"
            class:list={[
              'rounded-lg px-3 py-2 transition-colors hover:bg-ink-100 dark:hover:bg-ink-800',
              currentPath.startsWith('/posts') && 'text-brand-600 dark:text-brand-400',
            ]}
          >
            Posts
          </a>
          <a
            href="/community/"
            class:list={[
              'hidden rounded-lg px-3 py-2 transition-colors hover:bg-ink-100 sm:inline-flex dark:hover:bg-ink-800',
              currentPath.startsWith('/community') && 'text-brand-600 dark:text-brand-400',
            ]}
          >
            Community
          </a>

          <button
            type="button"
            id="theme-toggle"
            aria-label="Toggle dark mode"
            class="ml-1 inline-flex h-9 w-9 items-center justify-center rounded-lg border border-ink-200 text-ink-600 transition-colors hover:bg-ink-100 dark:border-ink-700 dark:text-ink-300 dark:hover:bg-ink-800"
          >
            <svg class="block h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
          </button>

          <a
            href={APP_URL}
            class="ml-2 hidden rounded-full bg-brand-600 px-4 py-2 font-semibold text-white shadow-soft transition-all hover:-translate-y-0.5 hover:bg-brand-700 hover:shadow-cozy md:inline-flex"
            rel="noopener"
          >
            Take the assessment →
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-ink-200/70 bg-ink-50/50 dark:border-ink-800/70 dark:bg-ink-900/50">
      <div class="mx-auto max-w-6xl px-6 py-12">
        <div class="grid gap-10 md:grid-cols-4">
          <div class="md:col-span-2">
            <div class="flex items-center gap-2">
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-brand-600 to-accent-500 text-white">
                P
              </span>
              <span class="text-lg font-bold">ParamAI<sup>™</sup> Blog</span>
            </div>
            <p class="mt-3 max-w-md text-sm text-ink-600 dark:text-ink-300">
              Honest, research-backed writing on career discovery, assessment
              science, and the 41 sectors powering India's next decade of work.
              Built by the team behind <a href={APP_URL} class="text-brand-600 hover:underline dark:text-brand-400" rel="noopener">paramai.in</a>.
            </p>
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-700 dark:text-ink-200">Explore</h3>
            <ul class="mt-4 space-y-2 text-sm text-ink-600 dark:text-ink-300">
              <li><a href="/sectors/" class="hover:text-brand-600 dark:hover:text-brand-400">All 41 sectors</a></li>
              <li><a href="/data/" class="hover:text-brand-600 dark:hover:text-brand-400">Numbers behind the careers</a></li>
              <li><a href="/posts/" class="hover:text-brand-600 dark:hover:text-brand-400">All posts</a></li>
              <li><a href="/community/" class="hover:text-brand-600 dark:hover:text-brand-400">Community</a></li>
              <li><a href="/rss.xml" class="hover:text-brand-600 dark:hover:text-brand-400">RSS feed</a></li>
            </ul>
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-700 dark:text-ink-200">Safety</h3>
            <ul class="mt-4 space-y-2 text-sm text-ink-600 dark:text-ink-300">
              <li><a href="/community-guidelines/" class="hover:text-brand-600 dark:hover:text-brand-400">Community guidelines</a></li>
              <li><a href="/grievance-officer/" class="hover:text-brand-600 dark:hover:text-brand-400">Grievance officer</a></li>
              <li><a href={`${APP_URL}/privacy`} class="hover:text-brand-600 dark:hover:text-brand-400" rel="noopener">Privacy policy</a></li>
              <li><a href={`${APP_URL}/terms`} class="hover:text-brand-600 dark:hover:text-brand-400" rel="noopener">Terms of service</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-ink-200/70 pt-6 text-xs text-ink-500 md:flex-row dark:border-ink-800/70">
          <p>&copy; {new Date().getFullYear()} ParamAI™. Made in India, for the world.</p>
          <p>
            Assessment at
            <a href={APP_URL} class="font-medium text-brand-600 hover:underline dark:text-brand-400" rel="noopener">paramai.in</a>
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement
        const next = root.classList.contains('dark') ? 'light' : 'dark'
        root.classList.toggle('dark', next === 'dark')
        localStorage.setItem('theme', next)
      })
    </script>
  </body>
</html>
