---
// Shared layout for posts and sector guides: breadcrumbs, header with art,
// published/updated line, key takeaways, table of contents, readable prose,
// CTA slot, related strip and comments. Uses theme tokens only.
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageArt from '@/components/PageArt.astro'
import { SITE_URL } from '@/consts'

interface Related {
  href: string
  kicker: string
  title: string
  blurb: string
}
interface Heading {
  depth: number
  slug: string
  text: string
}
interface Props {
  kind: 'post' | 'sector'
  title: string
  description: string
  tagline?: string
  kicker?: string
  author: string
  pubDate: Date
  updatedDate?: Date
  readingTime: string
  tags?: string[]
  takeaways?: string[]
  headings?: Heading[]
  related?: Related[]
  relatedTitle?: string
  canonical?: string
  /** unfinished page: noindex and no publish date */
  stub?: boolean
  /** path like /posts/slug/ for JSON-LD */
  path: string
}

const {
  kind,
  title,
  description,
  tagline,
  kicker,
  author,
  pubDate,
  updatedDate,
  readingTime,
  tags = [],
  takeaways = [],
  headings = [],
  related = [],
  relatedTitle = 'Keep reading',
  canonical,
  stub = false,
  path,
} = Astro.props

const fmt = (d: Date) => d.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
const iso = (d: Date) => d.toISOString().slice(0, 10)
const toc = headings.filter((h) => h.depth === 2)
const showToc = toc.length >= 3
const hubHref = kind === 'post' ? '/posts/' : '/sectors/'
const hubName = kind === 'post' ? 'Posts' : 'Sectors'
const url = new URL(path, SITE_URL).toString()
const showTags = tags.filter((t) => t !== 'sector')

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: iso(pubDate),
    dateModified: iso(updatedDate ?? pubDate),
    author: { '@type': 'Organization', name: author },
    publisher: { '@type': 'Organization', name: 'ParamAI™', url: 'https://paramai.in' },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
      { '@type': 'ListItem', position: 2, name: hubName, item: new URL(hubHref, SITE_URL).toString() },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
]
---

<BaseLayout title={`${title} | ParamAI™ Blog`} description={description} canonical={canonical} jsonLd={stub ? undefined : jsonLd} noindex={stub}>
  <section class="relative overflow-hidden border-b border-ink-200 dark:border-ink-800">
    <div
      class="absolute inset-0 -z-10 opacity-70 dark:opacity-30"
      style="background-image: radial-gradient(at 15% 20%, rgba(253,176,116,0.35), transparent 55%), radial-gradient(at 85% 30%, rgba(133,191,174,0.35), transparent 55%);"
    >
    </div>
    <div class="mx-auto grid max-w-5xl items-center gap-8 px-6 pt-10 pb-10 md:grid-cols-[1fr_15rem]">
      <div class="min-w-0">
        <nav aria-label="Breadcrumb" class="text-sm text-ink-600 dark:text-ink-300">
          <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <li><a href="/" class="hover:text-brand-600 hover:underline dark:hover:text-brand-300">Home</a></li>
            <li aria-hidden="true">›</li>
            <li><a href={hubHref} class="hover:text-brand-600 hover:underline dark:hover:text-brand-300">{hubName}</a></li>
            <li aria-hidden="true">›</li>
            <li aria-current="page" class="truncate font-medium text-ink-800 dark:text-ink-100 max-w-[14rem] sm:max-w-none">{title}</li>
          </ol>
        </nav>

        {kicker && (
          <p class="mt-6 inline-flex rounded-full bg-brand-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand-800 dark:bg-brand-900/60 dark:text-brand-200">{kicker}</p>
        )}
        <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">{title}</h1>
        <p class="mt-4 text-lg leading-8 text-ink-700 dark:text-ink-200">{tagline ?? description}</p>

        <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-600 dark:text-ink-300">
          <span class="font-semibold text-ink-800 dark:text-ink-100">{author}</span>
          {!stub && (<><span aria-hidden="true">·</span>
          <span>Published <time datetime={iso(pubDate)}>{fmt(pubDate)}</time></span></>)}
          {stub && (<><span aria-hidden="true">·</span><span class="font-medium text-ink-700 dark:text-ink-200">Draft, coming soon</span></>)}
          {!stub && updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span class="font-medium text-accent-700 dark:text-accent-300">Updated <time datetime={iso(updatedDate)}>{fmt(updatedDate)}</time></span>
            </>
          )}
          {!stub && (<><span aria-hidden="true">·</span>
          <span>{readingTime}</span></>)}
        </p>

        {showTags.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Topics">
            {showTags.map((t) => (
              <li class="rounded-full border border-ink-200 bg-white/70 px-2.5 py-0.5 text-xs font-medium text-ink-700 dark:border-ink-700 dark:bg-ink-900/60 dark:text-ink-200">{t}</li>
            ))}
          </ul>
        )}
      </div>
      <div class="hidden md:block"><PageArt kind={kind} /></div>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-6 py-10">
    {takeaways.length > 0 && (
      <aside class="mb-8 rounded-3xl border border-brand-200 bg-brand-50 p-6 shadow-soft dark:border-brand-300/30 dark:bg-ink-900" aria-labelledby="takeaways-h">
        <h2 id="takeaways-h" class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wide text-brand-800 dark:text-brand-200">
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3z"></path></svg>
          Key takeaways
        </h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 leading-7 text-ink-800 marker:text-brand-600 dark:text-ink-100">
          {takeaways.map((t) => <li>{t}</li>)}
        </ul>
      </aside>
    )}

    {showToc && (
      <nav aria-labelledby="toc-h" class="mb-10 rounded-3xl border border-ink-200 bg-white p-6 shadow-soft dark:border-ink-700 dark:bg-ink-900">
        <h2 id="toc-h" class="text-sm font-semibold uppercase tracking-wide text-ink-600 dark:text-ink-300">On this page</h2>
        <ol class="mt-3 grid gap-1.5 text-[0.95rem]">
          {toc.map((h, i) => (
            <li class="flex gap-2">
              <span class="w-5 shrink-0 text-right font-mono text-xs leading-6 text-ink-500 dark:text-ink-400">{i + 1}.</span>
              <a href={`#${h.slug}`} class="text-ink-800 underline-offset-2 hover:text-brand-600 hover:underline dark:text-ink-100 dark:hover:text-brand-300">{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <article>
      <div class="article-prose prose prose-lg dark:prose-invert">
        <slot />
      </div>

      <slot name="after" />

      {related.length > 0 && (
        <section class="mt-14 border-t border-ink-200 pt-10 dark:border-ink-800" aria-labelledby="related-h">
          <h2 id="related-h" class="text-sm font-semibold uppercase tracking-wider text-ink-600 dark:text-ink-300">{relatedTitle}</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            {related.map((r) => (
              <a href={r.href} class="group block rounded-3xl border border-ink-200 bg-white p-5 shadow-soft transition-all hover:-translate-y-1 hover:border-brand-300 hover:shadow-cozy dark:border-ink-700 dark:bg-ink-900">
                <p class="text-[11px] font-mono font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">{r.kicker}</p>
                <h3 class="mt-1 text-base font-bold leading-snug group-hover:text-brand-600 dark:group-hover:text-brand-300">{r.title}</h3>
                <p class="mt-1.5 line-clamp-3 text-sm leading-6 text-ink-600 dark:text-ink-300">{r.blurb}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      <slot name="comments" />
    </article>
  </div>

  <style is:global>
    /* Comfortable measure and rhythm */
    .article-prose { max-width: 68ch; margin-inline: auto; font-size: 1.0625rem; line-height: 1.75; }
    .article-prose h2 { margin-top: 2.5em; margin-bottom: 0.7em; font-weight: 700; letter-spacing: -0.01em; scroll-margin-top: 5.5rem; }
    .article-prose h3 { scroll-margin-top: 5.5rem; }
    .article-prose :where(p, li) { text-wrap: pretty; }
    .article-prose a { text-underline-offset: 3px; }
    .article-prose ul, .article-prose ol { padding-left: 1.4em; }
    .article-prose li { margin-block: 0.45em; }
    .article-prose li::marker { color: #C2410C; }
    .dark .article-prose li::marker { color: #FDB074; }
    .article-prose strong { color: inherit; font-weight: 700; }
    /* Pull quotes */
    .article-prose blockquote {
      margin: 2em 0; padding: 1.1em 1.4em; border-left: 4px solid #F97316; border-radius: 0 1.25rem 1.25rem 0;
      background: rgba(255, 230, 208, 0.55); font-size: 1.15em; font-style: normal; font-weight: 500; line-height: 1.6;
    }
    .dark .article-prose blockquote { background: rgba(253, 176, 116, 0.1); border-left-color: #FDB074; }
    .article-prose blockquote p:first-of-type::before, .article-prose blockquote p:last-of-type::after { content: none; }
    /* Tables */
    .article-prose table { display: block; overflow-x: auto; width: 100%; border-collapse: collapse; font-size: 0.95em; border: 1px solid #EEDFCB; border-radius: 1rem; }
    .dark .article-prose table { border-color: #43303B; }
    .article-prose thead th { background: rgba(122, 99, 84, 0.1); text-align: left; font-weight: 600; padding: 0.65em 0.9em; }
    .article-prose tbody td { padding: 0.6em 0.9em; border-top: 1px solid #EEDFCB; }
    .dark .article-prose tbody td { border-color: #43303B; }
    .article-prose code { font-size: 0.9em; padding: 0.15em 0.4em; border-radius: 0.4rem; background: rgba(122, 99, 84, 0.12); }
    .article-prose code::before, .article-prose code::after { content: none; }
    .article-prose hr { margin-block: 2.5em; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  </style>
</BaseLayout>
